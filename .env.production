# Production Environment Variables for GuruKool HomeSchool
# Copy these to your Vercel environment variables dashboard

# Core Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://gurukool-homeschool.vercel.app

# Database (Supabase) - Add your production credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Authentication
JWT_SECRET=your-production-jwt-secret-minimum-32-characters

# AI Services (Optional - can be empty for demo)
OPENAI_API_KEY=your-openai-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment

# WebSocket Configuration (Production URLs)
NEXT_PUBLIC_WS_URL=wss://gurukool-homeschool.vercel.app/ws

# MCP Server Configuration (Production endpoints)
MCP_EDUCATION_ENDPOINT=https://gurukool-homeschool.vercel.app/api/mcp/education
MCP_SECURITY_ENDPOINT=https://gurukool-homeschool.vercel.app/api/mcp/security
MCP_COMMUNICATION_ENDPOINT=https://gurukool-homeschool.vercel.app/api/mcp/communication

# Performance & Monitoring
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true

# Security
NEXTAUTH_URL=https://gurukool-homeschool.vercel.app
NEXTAUTH_SECRET=your-nextauth-secret-for-production