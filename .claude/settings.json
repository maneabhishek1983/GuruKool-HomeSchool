{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run type-check:*)",
      "Bash(npm install)",
      "Bash(npm run dev:*)",
      "WebFetch(domain:localhost)",
      "Bash(curl:*)",
      "Bash(npm run build:*)",
      "Bash(npm audit:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(NODE_ENV=production npm run build)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git config:*)",
      "Bash(npx vercel:*)",
      "Bash(git remote get-url:*)",
      "Bash(git remote set-url:*)",
      "Bash(GIT_CURL_VERBOSE=1 git push origin main)",
      "Bash(grep:*)",
      "Bash(BASE_URL=http://localhost:3002 npm run test:comprehensive)",
      "Bash(npm run test:e2e:*)",
      "Bash(npm run test:security:*)",
      "Bash(npm run test:*)",
      "Bash(node:*)",
      "Bash(tee:*)",
      "Bash(npm install:*)",
      "Bash(test:*)",
      "Bash(netstat:*)",
      "Bash(findstr:*)",
      "Bash(taskkill:*)",
      "Bash(cmd //c:*)",
      "Bash(powershell:*)",
      "Bash(cat:*)",
      "Bash(npm run verify:supabase:*)",
      "Bash(npm run verify:rls:*)",
      "Bash(supabase:*)",
      "Bash(npx tsc:*)",
      "Bash(python:*)",
      "Bash(tasklist)",
      "Bash(if exist .next rmdir /s /q .next)",
      "Bash(timeout:*)",
      "Bash(git fetch:*)",
      "Bash(npx eslint:*)",
      "Bash(git reset:*)",
      "Bash(git rev-parse:*)",
      "Bash(git pull:*)",
      "Bash(cut:*)",
      "Bash(dir:*)",
      "Bash(echo \"Open this file in your browser: file:///$PWD/test-deployed-signup.html\")",
      "Bash(del test-teacher-creation.js verify-teacher-fix.js)",
      "Bash(npx:*)",
      "Bash(del nul)",
      "Bash(git checkout:*)",
      "Bash(flutter:*)",
      "Bash(git mv:*)",
      "Bash(for file in build-output.txt type-check-errors.log type-check-full.txt type-check-output.txt typescript-errors.log CLEANUP_REPORT.json implementation-plan.json implementation-progress.json implementation-status-report.json QR_TEST_REPORT.json task-validation-report.json TEST_REPORT.json ui-implementation-report.json)",
      "Bash(do)",
      "Bash([ -f \"$file\" ])",
      "Bash(done)",
      "Bash(/dev/null echo \"\" echo \"📖 Documentation:\" find docs/ -name \"*.md\")",
      "Bash(xcodebuild:*)",
      "Read(//c/Users/abhis/**)",
      "Bash(adb:*)",
      "Bash(if [ -d \".claude/commands\" ])",
      "Bash(then ls .claude/commands/)",
      "Bash(else echo \"No commands directory\")",
      "Bash(fi:*)",
      "Bash(if [ -f \"claude_desktop_config.json\" ])",
      "Bash(then cat claude_desktop_config.json)",
      "Bash(elif [ -f \".claude/mcp.json\" ])",
      "Bash(then cat .claude/mcp.json)",
      "Bash(else echo \"No MCP configuration found\")"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit(**/*.ts)",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint --fix \"$FILE\" || true"
          }
        ]
      },
      {
        "matcher": "Edit(**/*.tsx)",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint --fix \"$FILE\" || true"
          }
        ]
      },
      {
        "matcher": "Edit(gurukool_teacher/**/*.dart)",
        "hooks": [
          {
            "type": "command",
            "command": "cd gurukool_teacher && dart format \"$FILE\" || true"
          }
        ]
      },
      {
        "matcher": "Write(src/app/api/**/*.ts)",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "A new API endpoint was created at $FILE. Run type-check to verify TypeScript correctness."
          }
        ]
      },
      {
        "matcher": "Write(supabase/migrations/*.sql)",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "A new database migration was created. Verify: 1) RLS policies included, 2) Indexes added, 3) Parent isolation enforced."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git push --force*)",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "⚠️ Force push detected. Confirm this is intended and the branch is safe to rewrite."
          }
        ]
      },
      {
        "matcher": "Bash(npm run db:reset*)",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "⚠️ Database reset will delete all data. Confirm development environment and backups."
          }
        ]
      },
      {
        "matcher": "Bash(rm -rf*)",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "⚠️ Recursive deletion detected. Verify target directory is correct."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*deploy*",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Production deployment requested. Verify: 1) type-check passes, 2) tests pass, 3) RLS verified, 4) kluster.ai passes."
          }
        ]
      }
    ]
  }
}
