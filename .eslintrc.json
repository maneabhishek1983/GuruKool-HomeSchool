{
  "extends": [
    "next/core-web-vitals",
    "prettier",
    "plugin:storybook/recommended"
  ],
  "rules": {
    "prefer-const": "error",
    "no-var": "error", 
    "no-console": "warn",
    "eqeqeq": "error",
    "curly": "warn",
    "react/no-unescaped-entities": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "@next/next/no-img-element": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  }
}