# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Configuration
JWT_SECRET=your-jwt-secret-key

# QR Code Configuration
# Generate a secure 32-byte base64 secret using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_PUBLIC_QR_SECRET=your-32-byte-base64-qr-secret

# AI Configuration
OPENAI_API_KEY=your-openai-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment

# WebSocket Configuration
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# MCP Server Configuration
MCP_EDUCATION_ENDPOINT=http://localhost:3001/mcp/education
MCP_SECURITY_ENDPOINT=http://localhost:3002/mcp/security
MCP_COMMUNICATION_ENDPOINT=http://localhost:3003/mcp/communication

# Development Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis Configuration (for distributed rate limiting)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Demo Credentials (optional - for development/staging only)
DEMO_PARENT_PASSWORD=parent123
DEMO_ADMIN_PASSWORD=admin123
DEMO_TEACHER_PASSWORD=teacher123
ENABLE_DEMO_CREDENTIALS=false

# Sentry Configuration (optional - for error tracking)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token