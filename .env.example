# Supabase Configuration (CRITICAL - Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Configuration (CRITICAL - Required)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-jwt-secret-key-minimum-32-characters

# QR Code Configuration (CRITICAL - Required)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: Use QR_SECRET (server-only), NOT NEXT_PUBLIC_QR_SECRET
QR_SECRET=your-32-byte-base64-qr-secret

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Upstash Redis Configuration (RECOMMENDED for production)
# Required for distributed rate limiting across serverless instances
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# AI Configuration (OPTIONAL - for AI features)
OPENAI_API_KEY=your-openai-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment

# MCP Server Configuration (OPTIONAL)
MCP_EDUCATION_ENDPOINT=http://localhost:3001/mcp/education
MCP_SECURITY_ENDPOINT=http://localhost:3002/mcp/security
MCP_COMMUNICATION_ENDPOINT=http://localhost:3003/mcp/communication

# Error Tracking (OPTIONAL but recommended for production)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Demo Credentials (DEVELOPMENT/STAGING ONLY - MUST be disabled in production)
ENABLE_DEMO_CREDENTIALS=false
DEMO_PARENT_PASSWORD=parent123
DEMO_ADMIN_PASSWORD=admin123
DEMO_TEACHER_PASSWORD=teacher123

# Node Environment
NODE_ENV=development

# Face Recognition Configuration (v2.0 - Server-Side Verification)
# Generate encryption key with: openssl rand -hex 32
FACE_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here
# Match threshold (0-1, lower = stricter matching)
FACE_MATCH_THRESHOLD=0.4
# Rate limit for face verification attempts per minute per teacher
FACE_VERIFY_RATE_LIMIT=10
# Feature flag to enable/disable face recognition UI
NEXT_PUBLIC_ENABLE_FACE_RECOGNITION=true
